// ~mem.fpb
#incluir "sischamada.fpb"
#incluir "impressao.fpb"

nulo* malocar(longo bytes) {
    longo tam = bytes + 16;
    longo* bruto = #chamada_sistema ALOCAR, nulo, tam, 3, 34, -1, 0;
    bruto[0] = bytes;
    
    car* baseCar = (car*)bruto;
    car* usuario = baseCar + 16;
    
    // escreverf("bytes alocados: %i\n", tam);
    
    retorne (nulo*)usuario;
}

bool mliberar(nulo* ptr) {
    car* usuario = (car*)ptr;
    car* baseCar = usuario + (-16);
    
    longo* bruto = (longo*)baseCar;
    longo tam = bruto[0] + 16;
    
    // escreverf("bytes alocados: %i\n", tam);
    
    retorne #chamada_sistema LIBERAR, bruto, tam;
}

nulo* mrealocar(nulo* ptr, longo bytes) {
    se(ptr == (nulo*)0) retorne malocar(bytes);
    car* origem = (car*)ptr;
    car* baseCar = origem + (-16);
    longo* bruto = (longo*)baseCar;
    longo n = bruto[0];
    se(bytes < n) n = bytes;
    nulo* nov = malocar(bytes);
    car* destino = (car*)nov;
    longo i = 0;
    enquanto(i < n) {
        destino[i] = origem[i];
        i++;
    }
    mliberar(ptr);
    retorne nov;
}