#incluir "~biblis/graficos/opengl/gles.fpb"
#incluir "~biblis/graficos/opengl/egl.fpb"
#incluir "~biblis/mem.fpb"

#classe Liberavel {
    bool liberado;
    
    nulo liberar() {
        liberado = verdade;
    }
}

#classe Vetor2 {
    flu x, y;
    
    nulo criar(flu x, flu y) {
        este.x = x;
        este.y = y;
    }
    
    nulo def(flu x, flu y) {
        este.x = x;
        este.y = y;
    }
}

#classe Vetor3 {
    flu x, y, z;
    
    nulo criar(flu x, flu y, flu z) {
        este.x = x;
        este.y = y;
        este.z = z;
    }
    
    nulo def(flu x, flu y, flu z) {
        este.x = x;
        este.y = y;
        este.z = z;
    }
}

#classe Programa herda Liberavel {
    int id;

    estatico int compilar(int tipo, car* fonte) {
        int s = GL20.criarShader(tipo);
        longo[1] fontes;
        fontes[0] = (longo)fonte;
        GL20.fonteShader(s, 1, fontes, 0);
        GL20.compilarShader(s);
        int[1] status;
        GL20.obterShaderIV(s, GL20.STATUS_COMPILACAO, status);
        se(status[0] == 0) {
            car[512] log;
            GL20.obterShaderInfo(s, 512, 0, log);
            // escrever(log);
            GL20.apagarShader(s);
            retorne 0;
        }
        retorne s;
    }

    estatico Programa* novo(car* vert, car* frag) {
        int v = Programa.compilar(GL20.SHADER_VERTICES, vert);
        int f = Programa.compilar(GL20.SHADER_FRAGMENTO, frag);
        int prog = GL20.criarPrograma();
        GL20.anexarShader(prog, v);
        GL20.anexarShader(prog, f);
        GL20.ligarPrograma(prog);
        GL20.apagarShader(v);
        GL20.apagarShader(f);
        Programa* p = malocar(bytes(Programa));
        p.liberado = falso;
        p.id = prog;
        retorne p;
    }

    nulo iniciar() {
        GL20.usarPrograma(este.id);
    }

    nulo fim() {
        GL20.usarPrograma(0);
    }

    @sobrepor
    nulo liberar() {
        GL20.apagarPrograma(este.id);
        Liberavel.liberar(este);
    }
}

#classe Modelo herda Liberavel {
    flu* vertices;
    
    estatico Modelo* novo(flu* vertices) {
        Modelo* c = malocar(bytes(Modelo));
        c.liberado = falso;
        c.vertices = vertices;
        retorne c;
    }
    
    @sobrepor
    nulo liberar() {
        mliberar(vertices);
        Liberavel.liberar(este);
    }
}

#classe ModeloUtil {
    estatico nulo ponto(flu* v, int i, flu x, flu y, flu z) {
        v[i] = x;
        v[i + 1] = y;
        v[i + 2] = z;
    }

    // dois triângulos a partir de 4 cantos (a, b, c, d)
    estatico nulo quad(flu* v, int i,
                       flu ax, flu ay, flu az,
                       flu bx, flu by, flu bz,
                       flu cx, flu cy, flu cz,
                       flu dx, flu dy, flu dz) {
        ModeloUtil.ponto(v, i,      ax, ay, az);
        ModeloUtil.ponto(v, i + 3,  bx, by, bz);
        ModeloUtil.ponto(v, i + 6,  cx, cy, cz);
        ModeloUtil.ponto(v, i + 9,  ax, ay, az);
        ModeloUtil.ponto(v, i + 12, cx, cy, cz);
        ModeloUtil.ponto(v, i + 15, dx, dy, dz);
    }

    estatico flu* criarCubo(flu dimX, flu dimY, flu dimZ) {
        flu x = dimX / 2.0f;
        flu y = dimY / 2.0f;
        flu z = dimZ / 2.0f;
        flu nx = -x;
        flu ny = -y;
        flu nz = -z;

        flu* v = malocar(bytes(flu) * 108);

        // frente (+Z)
        ModeloUtil.quad(v, 0,  nx, ny, z,   x, ny, z,   x, y, z,   nx, y, z);
        // trás (-Z)
        ModeloUtil.quad(v, 18, x, ny, nz,   nx, ny, nz,   nx, y, nz,   x, y, nz);
        // direita (+X)
        ModeloUtil.quad(v, 36, x, ny, z,   x, ny, nz,   x, y, nz,   x, y, z);
        // esquerda (-X)
        ModeloUtil.quad(v, 54, nx, ny, nz,   nx, ny, z,   nx, y, z,   nx, y, nz);
        // topo (+Y)
        ModeloUtil.quad(v, 72, nx, y, z,   x, y, z,   x, y, nz,   nx, y, nz);
        // base (-Y)
        ModeloUtil.quad(v, 90, nx, ny, nz,   x, ny, nz,   x, ny, z,   nx, ny, z);

        retorne v;
    }
}