int textam(car* txt) {
    int i = 0;
    enq(txt[i] != 0) {
        i = i + 1;
    }
    retorne i;
}

int texcomp(car* txt1, car* txt2) {
    int i = 0;
    por(; txt1[i] != 0; i++) {
        se(txt1[i] != txt2[i]) retorne 0;
    }
    se(txt2[i] != 0) retorne 0;
    
    retorne 1;
}

nulo inttex(int numero, car* buffer) {
    int valor = numero;

    int negativo = 0;
    se(numero < 0) {
        negativo = 1;
        valor = 0 - numero;
    }
    int ehZero = 0;
    se(valor == 0) {
        ehZero = 1;
    }
    se(ehZero == 1) {
        buffer[0] = 48;
        buffer[1] = 0;
        retorne;
    }
    int indice = 20;
    buffer[indice] = 0;
    indice = indice - 1;

    int continuar = 1;
    enq(continuar == 1) {
        int quociente = valor / 10;
        int resto = valor - (quociente * 10);
        
        buffer[indice] = resto + 48;
        indice = indice - 1;
        valor = quociente;

        se(valor == 0) {
            continuar = 0;
        }
    }
    se(negativo == 1) {
        buffer[indice] = 45;
        indice = indice - 1;
    }
    int inicio = 0;
    indice = indice + 1;

    int deslocando = 1;
    enq(deslocando == 1) {
        buffer[inicio] = buffer[indice];
        
        se(buffer[indice] == 0) {
            deslocando = 0;
        }
        inicio = inicio + 1;
        indice = indice + 1;
    }
}

int texint(car* txt) {
    int i = 0;
    enq(txt[i] == 32 || (txt[i] >= 9 && txt[i] <= 13)) {
        i++;
    }
    int sinal = 1;
    se(txt[i] == '-') {
        sinal = -1;
        i++;
    } senao se(txt[i] == '+') {
        i++;
    }
    int resultado = 0;
    enq(txt[i] >= '0' && txt[i] <= '9') {
        resultado = resultado * 10 + (txt[i] - '0');
        i++;
    }
    retorne resultado * sinal;
}