// graficos/zukara/janela.fpb
#incluir "~mem.fpb"
#incluir "~graficos/opengl/egl.fpb"

#classe Janela {
    nulo* idTela;
    nulo* nativa;
    ContextoEGL* contexto;
    int largura;
    int altura;
    bool aberta;

    Janela(nulo* idTela, nulo* nativa) {
        este.idTela = idTela;
        este.nativa = nativa;
        este.contexto = novo ContextoEGL();
        este.largura = 0;
        este.altura = 0;
        este.aberta = falso;
    }

    bool iniciar() {
        se(este.contexto.iniciar(este.idTela, este.nativa) == falso) {
            retorne falso;
        }
        este.aberta = verdade;
        este.atualizar();
        retorne verdade;
    }

    nulo atualizar() {
        este.largura = este.contexto.largura();
        este.altura = este.contexto.altura();
    }

    nulo trocarBuffers() {
        este.contexto.trocarBuffers();
        este.atualizar();
    }
    
    ~Janela() {
        apagar contexto;
    }
}