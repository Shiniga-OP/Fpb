// ~texs.fpb
#incluir "mem.fpb";

#classe Texto {
    car* txt;
    longo tam;

    nulo criar(car* lit) {
        longo n = textam(lit);
        car* buf = malocar(n + 1);
        por(longo i = 0; i <= n; i++) buf[i] = lit[i];
        este.txt = buf;
        este.tam = n;
    }

    nulo copiar(Texto* origem) {
        este.criar(origem.txt);
    }

    nulo liberar() {
        se(este.txt != 0) mliberar(este.txt);
        este.txt = 0;
        este.tam = 0;
    }

    Texto* somar(Texto* outro) {
        longo total = este.tam + outro.tam;
        Texto* r = mlocar(bytes(Texto));
        car* buf = malocar(total + 1);
        car* a = este.txt;
        car* b = outro.txt;
        longo i = 0;
        enquanto(i < este.tam) {
            buf[i] = a[i];
            i++;
        }
        longo j = 0;
        enquanto(j < outro.tam) {
            buf[i + j] = b[j];
            j++;
        }
        buf[total] = 0;
        r.txt = buf;
        r.tam = total;
        retorne r;
    }

    bool igual(Texto* outro) {
        retorne texcomp(este.txt, outro.txt);
    }
}

int caridc(car* txt, car c) {
    por(int i = 0; txt[i] != c;) {
        i++;
        se(txt[i] == c) retorne i;
    }
    retorne -1;
}

int caridcs(car* txt, car c) {
    int ocorrencias = 0;
    por(int i = 0; txt[i] != '\0'; i++) {
        se(txt[i] == c) ocorrencias++;
    }
    retorne ocorrencias;
}

int textam(car* txt) {
    int i = 0;
    enq(txt[i] != 0) {
        i = i + 1;
    }
    retorne i;
}

bool texcomp(car* txt1, car* txt2) {
    int i = 0;
    por(; txt1[i] != 0; i++) {
        se(txt1[i] != txt2[i]) retorne falso;
    }
    se(txt2[i] != 0) retorne falso;
    
    retorne verdade;
}

nulo inttex(int numero, car* buffer) {
    int valor = numero;

    bool negativo = falso;
    se(numero < 0) {
        negativo = verdade;
        valor = 0 - numero;
    }
    bool ehZero = falso;
    se(valor == 0) {
        ehZero = verdade;
    }
    se(ehZero) {
        buffer[0] = 48;
        buffer[1] = 0;
        retorne;
    }
    int indice = 20;
    buffer[indice] = 0;
    indice = indice - 1;

    bool continuar = verdade;
    enq(continuar) {
        int quociente = valor / 10;
        int resto = valor - (quociente * 10);
        
        buffer[indice] = resto + 48;
        indice = indice - 1;
        valor = quociente;

        se(valor == 0) {
            continuar = falso;
        }
    }
    se(negativo) {
        buffer[indice] = 45;
        indice = indice - 1;
    }
    int inicio = 0;
    indice = indice + 1;

    bool deslocando = verdade;
    enq(deslocando) {
        buffer[inicio] = buffer[indice];
        
        se(buffer[indice] == 0) {
            deslocando = falso;
        }
        inicio = inicio + 1;
        indice = indice + 1;
    }
}

int texint(car* txt) {
    int i = 0;
    enq(txt[i] == 32 || (txt[i] >= 9 && txt[i] <= 13)) {
        i++;
    }
    int sinal = 1;
    se(txt[i] == '-') {
        sinal = -1;
        i++;
    } senao se(txt[i] == '+') {
        i++;
    }
    int resultado = 0;
    enq(txt[i] >= '0' && txt[i] <= '9') {
        resultado = resultado * 10 + (txt[i] - '0');
        i++;
    }
    retorne resultado * sinal;
}

nulo dobrotex(dobro numero, int casas, car* buffer) {
    dobro valor = numero;
    bool negativo = falso;
    se(numero < 0.0) {
        negativo = verdade;
        valor = -numero;
    }
    longo escala = 1;
    por(int c = 0; c < casas; c++) {
        escala = escala * 10;
    }
    dobro escalaDobro = (dobro)escala;
    valor = valor + 0.5 / escalaDobro;

    longo inteiro = (longo)valor;
    longo fracao = (longo)((valor - (dobro)inteiro) * escalaDobro);
    se(fracao >= escala) {
        fracao = escala - 1;
    }
    int pos = 0;
    se(negativo) {
        buffer[pos] = 45;
        pos++;
    }
    car[24] digitos;
    int total = 0;
    bool continuar = verdade;
    enq(continuar) {
        longo quociente = inteiro / 10;
        longo resto = inteiro - (quociente * 10);
        digitos[total] = (car)(resto + 48);
        total++;
        inteiro = quociente;

        se(inteiro == 0) {
            continuar = falso;
        }
    }
    enq(total > 0) {
        total--;
        buffer[pos] = digitos[total];
        pos++;
    }
    se(casas > 0) {
        buffer[pos] = 46;
        pos++;
        int ultimo = pos + casas - 1;
        por(int i = 0; i < casas; i++) {
            longo quocFracao = fracao / 10;
            longo restoFracao = fracao - (quocFracao * 10);
            buffer[ultimo - i] = (car)(restoFracao + 48);
            fracao = quocFracao;
        }
        pos = pos + casas;
    }
    buffer[pos] = 0;
}